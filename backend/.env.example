# SQLite (default, zero-config). For Postgres:
# DATABASE_URL="postgresql://user:pass@host:5432/vpn_platform"
DATABASE_URL="file:./dev.db"

# Used to sign admin JWT sessions — change this to a long random string
JWT_SECRET="change-me-to-a-long-random-secret"

# Initial admin account (created by `npm run seed`)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-strong-password"

# Port the API server listens on
PORT=4000

# Public base URL where this API is reachable — used to build subscription
# links shown in the dashboard, e.g. https://api.yourdomain.com
PUBLIC_BASE_URL="http://localhost:4000"
